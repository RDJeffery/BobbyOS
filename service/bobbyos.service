[Unit]
Description=BobbyOS Launcher
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
ExecStart=/home/pi/BobbyOS/venv/bin/python /home/pi/BobbyOS/main.py
Restart=always
RestartSec=5
User=pi
Group=pi
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/pi/BobbyOS
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/pi/BobbyOS
ProtectHome=true

[Install]
WantedBy=graphical.target
